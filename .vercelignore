# Only the web application belongs in a Vercel deployment.
/*
!api
!public
!src
!index.html
!package.json
!package-lock.json
!vite.config.js
!vercel.json
# The landing page imports these committed validation reports at build time.
!docs
/docs/*
!/docs/validation
/docs/validation/*
!/docs/validation/reference-comparison.json
!/docs/validation/benchmark-evaluation
/docs/validation/benchmark-evaluation/*
!/docs/validation/benchmark-evaluation/shadow-baselines.json
!/docs/validation/benchmark-evaluation/native-results.json
